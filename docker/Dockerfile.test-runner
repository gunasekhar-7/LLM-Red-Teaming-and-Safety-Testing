# Test Runner - Multi-stage build for LLM Red-Teaming
# Optimized for CI/CD with minimal attack surface

# =============================================================================
# Stage 1: Builder - Install dependencies and workspace packages
# =============================================================================
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./
COPY libs ./libs
COPY apps ./apps
COPY src ./src

RUN uv venv /opt/venv && \
    /opt/venv/bin/uv pip install \
        -e libs/rag-target \
        -e libs/llm-provider \
        -e libs/guards \
        -e libs/test-harness \
        -e apps/reference-rag \
        -e apps/existing-rag-adapter \
        -e .

# =============================================================================
# Stage 2: Runtime - Minimal image with only runtime dependencies
# =============================================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY libs /app/libs
COPY apps /app/apps
COPY src /app/src
COPY scripts /app/scripts
COPY config /app/config
COPY dashboard /app/dashboard
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser && \
    chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "from llm_redteam_cli import app; print('OK')" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--help"]
