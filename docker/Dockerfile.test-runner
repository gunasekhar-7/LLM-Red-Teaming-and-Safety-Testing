# Test Runner - Multi-stage build for LLM Red-Teaming
# Optimized for CI/CD with minimal attack surface

# =============================================================================
# Stage 1: Builder - Install dependencies and workspace packages
# =============================================================================
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml README.md uv.lock* ./
COPY libs ./libs
COPY apps ./apps
COPY src ./src

# Install CPU-only PyTorch first to avoid multi-GB CUDA wheels in CI,
# install all workspace packages non-editably into /opt/venv, and
# pre-install the lightweight spaCy model so Presidio never downloads at runtime.
RUN uv venv --seed /opt/venv && \
    uv pip install --python /opt/venv/bin/python --no-cache \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.2.0" && \
    uv pip install --python /opt/venv/bin/python --no-cache \
        ./libs/rag-target \
        ./libs/llm-provider \
        ./libs/guards \
        ./libs/test-harness \
        ./apps/reference-rag \
        ./apps/existing-rag-adapter \
        . && \
    /opt/venv/bin/python -m spacy download en_core_web_sm

# =============================================================================
# Stage 2: Runtime - Minimal image with only runtime dependencies
# =============================================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY libs /app/libs
COPY apps /app/apps
COPY src /app/src
COPY scripts /app/scripts
COPY config /app/config
COPY dashboard /app/dashboard
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser && \
    mkdir -p /app/results && \
    chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "from llm_redteam_cli import app; print('OK')" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--help"]
