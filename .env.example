# Example environment configuration for deployment.
# Copy to .env and replace placeholder values before running in production.

# LLM Provider Configuration
# ---------------------------
# Configure at least one LLM provider. Use environment variables or a secret manager.

# OpenAI
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_BASE_URL=""

# Ollama (local, no API key needed)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# Embeddings
EMBEDDING_PROVIDER="ollama"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_BASE_URL="http://localhost:11434"
EMBEDDING_DIMENSION=1536

# Application Settings
# --------------------
APP_NAME="LLM Red-Teaming"
APP_VERSION="0.1.0"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ragdb"
PGVECTOR_DIMENSION=1536

# Security
# CRITICAL: Never commit real secrets. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_ENABLED=true
JWT_SECRET=""
JWT_ALGORITHM="HS256"
JWT_EXPIRY_MINUTES=60

# CORS (comma-separated or JSON array)
CORS_ORIGINS='["http://localhost:3000","http://localhost:8501"]'

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Retrieval Settings
TOP_K=5
SIMILARITY_THRESHOLD=0.7
MAX_CONTEXT_TOKENS=3000

# LLM Settings
LLM_PROVIDER="ollama"
LLM_MODEL="llama3.1:8b"
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# System Prompt
SYSTEM_PROMPT="You are a helpful AI assistant that answers questions based on the provided context."

# Probe & Testing Configuration
# -----------------------------
MAX_CONCURRENT=3
DEFAULT_PROBES="all"

# Statistical Validation
SIGNIFICANCE_LEVEL=0.01
EFFECT_SIZE_THRESHOLD=0.5

# Reporting
REPORT_FORMAT="html"
REPORT_DIR="audit-reports"

# Dashboard
DASHBOARD_HOST="0.0.0.0"
DASHBOARD_PORT=8501
